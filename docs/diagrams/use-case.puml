@startuml
skinparam shadowing false
skinparam linetype ortho
skinparam actorBorderColor #1B365D
skinparam actorFontColor #1E232D
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #1B365D
skinparam usecaseFontColor #1E232D
skinparam rectangleBorderColor #1B365D
skinparam rectangleBackgroundColor #F8FAFC
skinparam arrowColor #1B365D

actor "User" as User
actor "Student" as Student

rectangle "Student Accommodation" {
  usecase "View and Save Listing" as View_and_Save_Listing
  usecase "Request Viewing" as Request_Viewing
  usecase "Accept or Decline Viewing Requests" as Accept_or_Decline_Viewing_Requests
  usecase "Filter Accommodations" as Filter_Accommodations
  usecase "Send Message" as Send_Message
}

actor "Landlord" as Landlord

Student --|> User
Landlord --|> User
Student --> View_and_Save_Listing
View_and_Save_Listing <-- Landlord
View_and_Save_Listing ..> Filter_Accommodations : <<extend>>
Student --> Request_Viewing
Accept_or_Decline_Viewing_Requests <-- Landlord
Accept_or_Decline_Viewing_Requests ..> Send_Message : <<extend>>

@enduml
